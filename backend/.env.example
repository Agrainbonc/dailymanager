# =============================================================================
# Daily Manager 本地环境配置模板
# =============================================================================
# 复制此文件为 backend/.env 即可生效：
#   Copy-Item backend/.env.example backend/.env
# =============================================================================

# [基础服务设置]
DAILY_MANAGER_HOST=127.0.0.1
DAILY_MANAGER_PORT=8000

# 本地数据存储根目录（默认保存在项目根目录下的 data/ 目录）
# DAILY_MANAGER_DATA_DIR=D:\codes\items\dailymanager\data

# =============================================================================
# [AI 语音识别 (ASR) 配置]
# =============================================================================
# ASR 提供方选项：zhixin (默认直连9001) | mock | dashscope | openai | qwen_local
DAILY_MANAGER_ASR_PROVIDER=zhixin

# 1. 本地 Zhixin-AI-Companion ASR 服务（默认监听 9001 端口 WebSocket）
ZHIXIN_ASR_URL=ws://127.0.0.1:9001/v1/stream
# 若 Zhixin 配置了 ZHIXIN_MODEL_CORE_TOKEN 鉴权，可在此配置相同 Token：
# ZHIXIN_MODEL_CORE_TOKEN=change-me

# 2. 若使用 阿里云 DashScope (Paraformer / Qwen-Audio / SenseVoice)：
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_ASR_MODEL=qwen-audio-turbo

# 3. 若使用 OpenAI 兼容语音转录（Whisper / 本地 faster-whisper-server / Groq）：
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ASR_MODEL=whisper-1

# =============================================================================
# [AI 多模态视觉理解 (Vision) 配置]
# =============================================================================
# 视觉提供方选项：mock (默认开箱即用) | openai | dashscope
DAILY_MANAGER_VISION_PROVIDER=mock

# 通用多模态大模型配置（支持 Gemini OpenAI 兼容端点、DashScope qwen-vl-max、本地 Ollama/vLLM）
# VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen-vl-max

# 兼容别名（如在其他项目中习惯使用的变量名，Daily Manager 会自动识别）：
# KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-vl-max
